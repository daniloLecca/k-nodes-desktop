{
  "name": "vipnodes",
  "version": "1.0.0",
  "description": "VIPNODES Desktop",
  "author": "Danilo Lecca",
  "repository": {
    "type": "git",
    "url": "https://github.com/daniloLecca/vipnodes-desktop.git"
  },
  "private": true,
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder --publish never",
    "electron:build:win": "vite build && electron-builder --win --publish never",
    "electron:build:linux": "vite build && electron-builder --linux --publish never",
    "electron:build:mac": "vite build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.vipnodes.desktop",
    "productName": "VIPNODES",
    "directories": {
      "output": "release"
    },
    "publish": null,
    "files": [
      "dist/**/*",
      "electron-main.js"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend-dist",
        "filter": [
          "backend-api*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/vipnodes-logo.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/vipnodes-logo.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/vipnodes-logo.png"
    }
  },
  "dependencies": {
    "d3": "^7.9.0",
    "graphology": "^0.26.0",
    "graphology-layout-force": "^0.2.4",
    "html2pdf.js": "^0.14.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sigma": "^3.0.2",
    "vue": "^3.5.27",
    "vue-progressbar": "^0.7.5",
    "vue-router": "^5.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5"
  }
}