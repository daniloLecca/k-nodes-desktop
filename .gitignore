# --- SISTEMA OPERATIVO ---
.DS_Store
Thumbs.db
*.log

# --- IDE & EDITOR (VS Code, PyCharm, JetBrains) ---
.vscode/
.idea/
*.swp
*.swo

# --- PYTHON (Backend) ---
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments (quelli locali)
.venv/
venv/
env/
ENV/

# Environment variables (potrebbero contenere password!)
.env
.env.*

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebooks (se li usi per analisi dati)
.ipynb_checkpoints

# --- NODE.JS / VUE (Frontend) ---
# Dependencies (MOLTO IMPORTANTE: non committare mai node_modules)
node_modules/
/frontend/node_modules/

# Production Build Output
/frontend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- DOCKER ---
# A volte si creano file temporanei docker, ma di solito nulla da ignorare qui
# a meno che tu non abbia volumi mappati dentro la cartella del progetto
# che contengono dati (es. database sqlite)
*.sqlite3
*.db